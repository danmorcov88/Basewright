---
# A profile is a directory of declarative YAML that this project defines and validates
# against its own JSON Schema. One of its eight files is called requirements.yml, which is
# also the name Galaxy uses for something entirely different -- so the linter is told these
# are ordinary YAML rather than left to guess and be wrong about every profile in the
# repository.
kinds:
  # A molecule scenario is a directory of playbooks, so a file of tasks one of them
  # includes has to be named as such or the linter reads `- name:` at the top of it as a
  # play and reports every task in the file as an invalid play attribute.
  - tasks: "test/molecule/*/tasks/*.yml"
  - yaml: "profiles/**/*.yml"
  - yaml: "test/fixtures/profiles/**/*.yml"

exclude_paths:
  - .venv/
  - .git/
