{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basewright.dev/schema/plan.schema.json",
  "title": "Plan artifact",
  "description": "The contract between the verbs. Plan writes it, apply consumes it and nothing else, verify compares the running instance against it. It is also the artifact a second person reviews and a change request carries, which is why it is safe to share by construction: a secret entry has a name and a location and no field a value could go in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "generated_at",
    "tool_version",
    "profile",
    "request",
    "host",
    "preflight",
    "parameters",
    "layout",
    "changes",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "The version of this contract. Apply refuses a plan whose major version it does not implement, rather than guessing at a field that moved."
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{6,32}$",
      "description": "Derived from the plan's own content, so identical inputs produce an identical id and a plan can be found again by the id printed in a task log."
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC, to the second. The only field that legitimately differs between two otherwise identical plans."
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "version"],
      "properties": {
        "engine": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "description": "The profile version, not the engine version. It is what lets a value in a six-month-old plan be traced to the rule that produced it."
        }
      }
    },
    "request": { "$ref": "#/$defs/request" },
    "host": { "$ref": "#/$defs/host" },
    "preflight": { "$ref": "#/$defs/preflight" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" },
      "description": "Every tuned setting, each carrying the rule that produced it and that rule's reasoning."
    },
    "layout": { "$ref": "#/$defs/layout" },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" },
      "description": "Everything apply would do, in the order it would do it. Nothing existing is removed or overwritten, which is why there is no remove action."
    },
    "secrets": {
      "type": "array",
      "items": { "$ref": "#/$defs/secret" },
      "description": "The secrets the instance needs, named by where they are stored. There is deliberately nowhere in this object for a value."
    },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "engine", "version", "version_source", "environment", "instance"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z._-]{0,15}$" },
        "version_source": {
          "enum": ["requested", "profile_default"],
          "description": "Whether a human named the version or the profile default was used. The plan says which, because the two are not the same decision."
        },
        "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "instance": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "cpu", "memory", "storage"],
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "distro", "version"],
          "properties": {
            "family": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,15}$" },
            "distro": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
            "version": { "type": "string", "minLength": 1 },
            "pretty_name": { "type": "string", "minLength": 1 },
            "kernel": { "type": "string", "minLength": 1 }
          }
        },
        "arch": {
          "enum": ["x86_64", "aarch64", "ppc64le", "s390x"],
          "description": "The processor architecture of the host, as the support matrix spells it."
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cores"],
          "properties": {
            "cores": { "type": "integer", "minimum": 1 },
            "model": { "type": "string", "minLength": 1 }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_bytes"],
          "properties": {
            "total_bytes": { "type": "integer", "minimum": 1 },
            "swap_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mount" }
        },
        "time_sync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "synchronized"],
          "properties": {
            "service": { "type": "string", "minLength": 1 },
            "synchronized": { "type": "boolean" }
          }
        }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount", "free_bytes"],
      "properties": {
        "mount": { "type": "string", "pattern": "^/" },
        "free_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "filesystem": { "type": "string", "minLength": 1 },
        "rotational": { "type": "boolean" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "results"],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "warn", "block"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "warn": { "type": "integer", "minimum": 0 },
            "block": {
              "const": 0,
              "description": "A block produces a refusal, never a plan. A plan carrying a block is not a thing that can exist, so the contract says so rather than leaving it to a convention."
            }
          }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate_result" }
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "outcome", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*([.][a-z][a-z0-9_]*)+$" },
        "severity": {
          "enum": ["block", "warn"],
          "description": "How badly the rule matters. There are two severities and there is no third, so a warning cannot be promoted into a refusal, and a refusal cannot be demoted at run time."
        },
        "outcome": {
          "enum": ["pass", "warn", "skip"],
          "description": "What the rule did on this host. A rule of severity block that passes reports pass; one that did not apply reports skip."
        },
        "title": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "value", "rule", "why"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["string", "number", "boolean"],
          "description": "Rendered as the engine's configuration file expects to read it."
        },
        "rule": { "type": "string", "pattern": "^[a-z][a-z0-9]*([.][a-z][a-z0-9_]*)+$" },
        "why": { "type": "string", "minLength": 10 },
        "bounded_by": {
          "enum": ["min", "max"],
          "description": "Present when the computed value hit a floor or a ceiling, because a clamped value says something different about the host than one that landed inside its bounds."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "service_account"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/planned_path" }
        },
        "service_account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "shell", "create"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "group": { "type": "string", "minLength": 1 },
            "shell": { "type": "string", "pattern": "^/" },
            "create": { "type": "boolean" }
          }
        }
      }
    },
    "planned_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "path", "mode", "owner", "group"],
      "properties": {
        "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
        "path": { "type": "string", "pattern": "^/" },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "owner": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "mount": { "type": "string", "pattern": "^/" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "description"],
      "properties": {
        "action": {
          "enum": ["add", "modify"],
          "description": "There is no remove. Apply creates and configures; it does not drop data directories, and it does not overwrite a file without leaving a timestamped copy beside it."
        },
        "description": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "Where the secret is stored, so that someone can find it. Never the secret."
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "warnings_require_acknowledgement"],
      "properties": {
        "applicable": { "type": "boolean" },
        "warnings_require_acknowledgement": {
          "type": "boolean",
          "description": "True when the plan carries warnings. Apply refuses until they are acknowledged explicitly: a warning nobody has to answer for becomes invisible within a month."
        }
      }
    }
  }
}
