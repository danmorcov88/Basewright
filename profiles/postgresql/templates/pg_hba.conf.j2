#
# Local connections only, and no rule anywhere on this file grants access without a
# password. That is a placeholder rather than a policy: the networks this instance should
# accept, and the roles they may connect as, are one of the seven things that have to come
# from the estate before this profile stops being a defensible default.
#
# A new instance therefore starts reachable only from the machine it runs on. Widening it
# is a decision somebody makes on purpose, in this profile, in a pull request.

# The service account administers the cluster over the local socket, identified by the
# operating system rather than by a password nobody would ever rotate.
local   all             {{ layout.service_account.name }}                     peer

# Everything else proves who it is. scram-sha-256 rather than md5: md5 has been the wrong
# answer since PostgreSQL 10 offered an alternative.
local   all             all                                                   scram-sha-256
host    all             all             127.0.0.1/32                          scram-sha-256
host    all             all             ::1/128                               scram-sha-256
